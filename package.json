{
  "name": "setup-evolve",
  "version": "1.0.3",
  "description": "GitHub Action to install the evolve CLI with supply-chain verification",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "bun build src/main.ts --target=node --format=esm --sourcemap=linked --outdir=dist --entry-naming=index.js --define __dirname=import.meta.dirname",
    "check": "bun ./node_modules/@biomejs/biome/bin/biome lint .",
    "check:fix": "bun ./node_modules/@biomejs/biome/bin/biome lint --write .",
    "format": "bun fmt --no-script",
    "typecheck": "bun check --no-script",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage --reporter=junit --reporter-outfile=coverage/junit.xml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitwise-media-group/setup-evolve.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/cache": "6.3.0",
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@actions/io": "3.0.2",
    "@actions/tool-cache": "4.0.0",
    "semver": "7.8.6",
    "sigstore": "5.0.0",
    "snappyjs": "0.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.4",
    "@types/semver": "7.8.0",
    "@types/snappyjs": "0.7.1"
  }
}
